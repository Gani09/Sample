package com.fiserv.fef.parquet.util;

import com.fiserv.fef.hadoop.HadoopClientManager;
import com.fiserv.fef.utils.PropertiesUtil;

import java.util.Objects;

/**
 * Backward-compatible facade for row counting.
 * Delegates to ParquetRowCountUtil.
 */
public final class AdaptiveParquetRowCount {
    private AdaptiveParquetRowCount() {}

    public enum Mode { AUTO, METADATA, SCAN }

    public static final class Result {
        public final long rowCount;
        public final String source;
        public final String normalizedPath;

        public Result(long rowCount, String source, String normalizedPath) {
            this.rowCount = rowCount;
            this.source = source;
            this.normalizedPath = normalizedPath;
        }
    }

    public static Result count(HadoopClientManager.HadoopClientContext hCtx, String parquetFileName) {
        String m = PropertiesUtil.getInstance().getProperty("parquet.row.count.mode", "AUTO").trim().toUpperCase();
        Mode mode;
        try {
            mode = Mode.valueOf(m);
        } catch (Exception e) {
            mode = Mode.AUTO;
        }
        return count(hCtx, parquetFileName, mode);
    }

    public static Result count(HadoopClientManager.HadoopClientContext hCtx, String parquetFileName, Mode mode) {
        Objects.requireNonNull(hCtx, "hCtx");
        Objects.requireNonNull(parquetFileName, "parquetFileName");
        Objects.requireNonNull(mode, "mode");

        ParquetRowCountUtil.Mode m;
        switch (mode) {
            case METADATA -> m = ParquetRowCountUtil.Mode.METADATA;
            case SCAN -> m = ParquetRowCountUtil.Mode.SCAN;
            default -> m = ParquetRowCountUtil.Mode.AUTO;
        }

        ParquetRowCountUtil.Result r = ParquetRowCountUtil.count(hCtx, parquetFileName, m);
        return new Result(r.rowCount, r.source, r.normalizedPath);
    }
}
