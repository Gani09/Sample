package com.fiserv.fef.gherkin;

import java.util.ArrayList;
import java.util.List;

/**
 * Parsed Gherkin feature representation
 */
public class ParsedFeature {

    private String name;
    private String description;
    private List<ParsedScenario> scenarios;

    public ParsedFeature() {
        this.scenarios = new ArrayList<>();
    }

    public ParsedFeature(String name) {
        this();
        this.name = name;
    }

    public void addScenario(ParsedScenario scenario) {
        this.scenarios.add(scenario);
    }

    // Getters and Setters
    public String getName() { return name; }
    public void setName(String name) { this.name = name; }

    public String getDescription() { return description; }
    public void setDescription(String description) { this.description = description; }

    public List<ParsedScenario> getScenarios() { return scenarios; }
    public void setScenarios(List<ParsedScenario> scenarios) { this.scenarios = scenarios; }
}
