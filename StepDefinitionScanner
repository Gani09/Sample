package com.fiserv.fef.gherkin;

import org.slf4j.Logger;
import org.slf4j.LoggerFactory;

import java.io.File;
import java.io.IOException;
import java.net.URL;
import java.net.URLDecoder;
import java.util.ArrayList;
import java.util.Enumeration;
import java.util.List;
import java.util.jar.JarEntry;
import java.util.jar.JarFile;

/**
 * Scans and loads step definition classes from a package
 */
public class StepDefinitionScanner {

    private static final Logger LOG = LoggerFactory.getLogger(StepDefinitionScanner.class);

    /**
     * Scan package for step definition classes
     * Works with both filesystem and JAR files
     */
    public static List<Class<?>> scanPackage(String packageName) {
        LOG.info("Scanning package for step definitions: {}", packageName);

        List<Class<?>> classes = new ArrayList<>();

        try {
            String path = packageName.replace('.', '/');
            ClassLoader classLoader = Thread.currentThread().getContextClassLoader();

            Enumeration<URL> resources = classLoader.getResources(path);

            while (resources.hasMoreElements()) {
                URL resource = resources.nextElement();
                String protocol = resource.getProtocol();

                LOG.debug("Scanning resource: {} [protocol: {}]", resource, protocol);

                if ("file".equals(protocol)) {
                    // Scanning from file system (e.g., during development)
                    File directory = new File(URLDecoder.decode(resource.getFile(), "UTF-8"));
                    if (directory.exists()) {
                        classes.addAll(findClasses(directory, packageName));
                    }
                } else if ("jar".equals(protocol)) {
                    // Scanning from JAR file (e.g., in production)
                    classes.addAll(findClassesInJar(resource, path));
                }
            }

            LOG.info("Found {} step definition classes", classes.size());

        } catch (Exception e) {
            LOG.error("Failed to scan package: {}", packageName, e);
        }

        return classes;
    }

    /**
     * Find classes in JAR file
     */
    private static List<Class<?>> findClassesInJar(URL resource, String path) {
        List<Class<?>> classes = new ArrayList<>();

        try {
            String jarPath = resource.getPath().substring(5, resource.getPath().indexOf("!"));
            jarPath = URLDecoder.decode(jarPath, "UTF-8");

            LOG.debug("Scanning JAR file: {}", jarPath);

            try (JarFile jar = new JarFile(jarPath)) {
                Enumeration<JarEntry> entries = jar.entries();

                while (entries.hasMoreElements()) {
                    JarEntry entry = entries.nextElement();
                    String name = entry.getName();

                    // Check if entry is in our package and is a class file
                    if (name.startsWith(path) && name.endsWith(".class")) {
                        String className = name.substring(0, name.length() - 6)
                                .replace('/', '.');

                        try {
                            Class<?> clazz = Class.forName(className);

                            // Check if class has step definition annotations
                            if (hasStepDefinitions(clazz)) {
                                classes.add(clazz);
                                LOG.debug("Found step definition class: {}", className);
                            }

                        } catch (ClassNotFoundException | NoClassDefFoundError e) {
                            LOG.debug("Could not load class: {}", className);
                        }
                    }
                }
            }

        } catch (IOException e) {
            LOG.error("Failed to scan JAR file", e);
        }

        return classes;
    }

    /**
     * Recursively find classes in directory
     */
    private static List<Class<?>> findClasses(File directory, String packageName) {
        List<Class<?>> classes = new ArrayList<>();

        if (!directory.exists()) {
            return classes;
        }

        File[] files = directory.listFiles();
        if (files == null) {
            return classes;
        }

        for (File file : files) {
            if (file.isDirectory()) {
                classes.addAll(findClasses(file, packageName + "." + file.getName()));
            } else if (file.getName().endsWith(".class")) {
                String className = packageName + '.' +
                        file.getName().substring(0, file.getName().length() - 6);

                try {
                    Class<?> clazz = Class.forName(className);

                    // Check if class has step definition annotations
                    if (hasStepDefinitions(clazz)) {
                        classes.add(clazz);
                    }

                } catch (ClassNotFoundException e) {
                    LOG.warn("Class not found: {}", className);
                }
            }
        }

        return classes;
    }

    /**
     * Check if class has step definition methods
     */
    private static boolean hasStepDefinitions(Class<?> clazz) {
        for (java.lang.reflect.Method method : clazz.getDeclaredMethods()) {
            if (method.isAnnotationPresent(com.fiserv.fef.gherkin.annotations.Given.class) ||
                    method.isAnnotationPresent(com.fiserv.fef.gherkin.annotations.When.class) ||
                    method.isAnnotationPresent(com.fiserv.fef.gherkin.annotations.Then.class)) {
                return true;
            }
        }
        return false;
    }
}
