package com.fiserv.fef.gherkin;

import com.fiserv.fef.exceptions.GherkinExecutionException;
import com.fiserv.fef.models.*;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;

import java.util.ArrayList;
import java.util.List;
import java.util.concurrent.*;
import java.util.stream.Collectors;

/**
 * Main Gherkin executor that runs Cucumber scenarios
 * Supports parallel execution of scenarios with ISOLATED contexts
 *
 * CONTEXT ISOLATION STRATEGY:
 * - Each scenario gets its own ValidationContext instance via createIsolatedCopy()
 * - Shared resources (MongoClient, Config) are reused across scenarios (thread-safe)
 * - Scenario-specific data (datasets, variables, results) are isolated per scenario
 * - This prevents race conditions and data corruption during parallel execution
 *
 * Thread Safety:
 * - ThreadLocal is used to bind context to the executing thread
 * - ConcurrentHashMap is used in ValidationContext for thread-safe operations
 * - Each scenario runs in its own thread with its own context instance
 */
public class GherkinExecutor {

    private static final Logger LOG = LoggerFactory.getLogger(GherkinExecutor.class);

    private final StepDefinitionRegistry stepRegistry;
    private final FeatureParser featureParser;
    private final int parallelScenarios;

    // Thread pool for parallel scenario execution
    private final ExecutorService executorService;

    public GherkinExecutor() {
        this(4);  // Default: 4 scenarios in parallel
    }

    public GherkinExecutor(int parallelScenarios) {
        this.parallelScenarios = parallelScenarios;
        this.stepRegistry = new StepDefinitionRegistry();
        this.featureParser = new FeatureParser();
        this.executorService = Executors.newFixedThreadPool(parallelScenarios);

        LOG.info("GherkinExecutor initialized: parallelism={}", parallelScenarios);
    }

    /**
     * Execute Gherkin feature file
     *
     * @param featureText Gherkin feature text
     * @param context Validation context
     * @return Validation result
     */
    public ValidationResult execute(String featureText, ValidationContext context) {
        LOG.info("Executing Gherkin feature in Source Tenant Database : {} and Target Tenant Database : {}" , context.getSrcTenantDatabase().getName() , context.getTargetTenantDatabase().getName());

        long startTime = System.currentTimeMillis();

        try {
            // Parse feature file
            ParsedFeature parsedFeature = featureParser.parse(featureText);

            // Set context as current for step definitions
            ValidationContext.setCurrent(context);

            // Create result
            ValidationResult result = new ValidationResult();
            result.setFeatureName(parsedFeature.getName());

            // Execute scenarios
            List<ScenarioResult> scenarioResults = executeScenarios(
                    parsedFeature.getScenarios(),
                    context
            );

            // Aggregate results
            result.setScenarioResults(scenarioResults);
            result.setPassed(allScenariosPassed(scenarioResults));

            long duration = System.currentTimeMillis() - startTime;
            result.setDurationMs(duration);

            LOG.info("Feature execution complete: passed={}, duration={}ms",
                    result.isPassed(), duration);

            return result;

        } catch (Exception e) {
            LOG.error("Feature execution failed", e);

            ValidationResult result = new ValidationResult();
            result.setPassed(false);
            result.setErrorMessage("Feature execution failed: " + e.getMessage());
            result.setDurationMs(System.currentTimeMillis() - startTime);

            return result;

        } finally {
            ValidationContext.removeCurrent();
        }
    }

    /**
     * Execute scenarios in parallel with isolated contexts
     */
    private List<ScenarioResult> executeScenarios(
            List<ParsedScenario> scenarios,
            ValidationContext baseContext
    ) {
        LOG.info("Executing {} scenarios in parallel with isolated contexts", scenarios.size());

        if (scenarios.isEmpty()) {
            return new ArrayList<>();
        }

        // Create execution tasks with isolated contexts per scenario
        List<Callable<ScenarioResult>> tasks = scenarios.stream()
                .map(scenario -> (Callable<ScenarioResult>) () -> {
                    // Create isolated context for this scenario
                    ValidationContext isolatedContext = baseContext.createIsolatedCopy();
                    return executeScenario(scenario, isolatedContext);
                })
                .collect(Collectors.toList());

        try {
            // Execute in parallel
            List<Future<ScenarioResult>> futures = executorService.invokeAll(tasks);

            // Collect results
            List<ScenarioResult> results = new ArrayList<>();
            for (Future<ScenarioResult> future : futures) {
                results.add(future.get());
            }

            return results;

        } catch (InterruptedException | ExecutionException e) {
            LOG.error("Parallel scenario execution failed", e);
            throw new GherkinExecutionException("Failed to execute scenarios in parallel", e);
        }
    }

    /**
     * Execute single scenario with isolated context.
     * Supports parallel execution of consecutive independent read steps (e.g., source + target parquet reads).
     */
    private ScenarioResult executeScenario(ParsedScenario scenario, ValidationContext context) {
        LOG.debug("Executing scenario: {} with isolated context (thread: {})",
                  scenario.getName(), Thread.currentThread().getName());

        long startTime = System.currentTimeMillis();

        // Set context for this thread
        ValidationContext.setCurrent(context);

        ScenarioResult result = new ScenarioResult(scenario.getName());

        try {
            List<ParsedStep> steps = scenario.getSteps();
            int i = 0;

            while (i < steps.size()) {
                // Detect a batch of consecutive parallelizable read steps
                List<ParsedStep> parallelBatch = new ArrayList<>();
                while (i < steps.size() && isParallelizableReadStep(steps.get(i))) {
                    parallelBatch.add(steps.get(i));
                    i++;
                }

                if (parallelBatch.size() > 1) {
                    // Execute batch in parallel
                    LOG.info("Executing {} read steps in parallel", parallelBatch.size());
                    List<StepResult> batchResults = executeStepsInParallel(parallelBatch, context);
                    for (StepResult sr : batchResults) {
                        result.addStepResult(sr);
                        if (!sr.isPassed()) {
                            result.setPassed(false);
                            result.setFailureMessage(sr.getErrorMessage());
                            break;
                        }
                    }
                    if (!result.isPassed()) break;
                } else if (parallelBatch.size() == 1) {
                    // Single read step — run sequentially
                    StepResult stepResult = executeStep(parallelBatch.get(0), context);
                    result.addStepResult(stepResult);
                    if (!stepResult.isPassed()) {
                        result.setPassed(false);
                        result.setFailureMessage(stepResult.getErrorMessage());
                        break;
                    }
                } else {
                    // Non-parallelizable step — run sequentially
                    StepResult stepResult = executeStep(steps.get(i), context);
                    result.addStepResult(stepResult);
                    if (!stepResult.isPassed()) {
                        result.setPassed(false);
                        result.setFailureMessage(stepResult.getErrorMessage());
                        break;
                    }
                    i++;
                }
            }

            // After all steps, capture scenario details (source/target counts, ratios, etc.)
            ScenarioDetails details = buildScenarioDetailsFromContext(context);
            if (details != null) {
                result.setDetails(details);
            }

            long duration = System.currentTimeMillis() - startTime;
            result.setDurationMs(duration);

            LOG.debug("Scenario complete: {} - passed={}, duration={}ms (thread: {})",
                    scenario.getName(), result.isPassed(), duration, Thread.currentThread().getName());

        } catch (Exception e) {
            LOG.error("Scenario execution failed: {}", scenario.getName(), e);
            result.setPassed(false);
            result.setFailureMessage("Scenario failed: " + e.getMessage());
        } finally {
            ValidationContext.removeCurrent();
        }

        return result;
    }

    /**
     * Determine if a step can be parallelized with adjacent read steps.
     * Parallelizable steps are independent data-loading steps that write to different context keys.
     */
    private boolean isParallelizableReadStep(ParsedStep step) {
        String text = step.getText();
        if (text == null) return false;

        // Match patterns like: I read "..." from "..." parquet file as "source/target" data
        // Also match: I load source/target records from Parquet file
        // Also match: source/target collection "..." filtered by:
        String lower = text.toLowerCase();
        return lower.contains("parquet file as \"source\"")
                || lower.contains("parquet file as \"target\"")
                || lower.contains("i load source records from parquet")
                || lower.contains("i load target records from parquet")
                || (lower.startsWith("i read") && lower.contains("parquet file as"));
    }

    /**
     * Execute multiple independent steps in parallel sharing the same context.
     * Each step writes to different context keys (source_* vs target_*), so this is safe.
     */
    private List<StepResult> executeStepsInParallel(List<ParsedStep> steps, ValidationContext context) {
        List<Callable<StepResult>> tasks = steps.stream()
                .map(step -> (Callable<StepResult>) () -> {
                    ValidationContext.setCurrent(context);
                    try {
                        return executeStep(step, context);
                    } finally {
                        ValidationContext.removeCurrent();
                    }
                })
                .collect(Collectors.toList());

        try {
            List<Future<StepResult>> futures = executorService.invokeAll(tasks);
            List<StepResult> results = new ArrayList<>();
            for (Future<StepResult> f : futures) {
                results.add(f.get());
            }
            return results;
        } catch (InterruptedException | ExecutionException e) {
            LOG.error("Parallel step execution failed", e);
            StepResult errorResult = new StepResult("parallel-batch", false,
                    "Parallel step execution failed: " + e.getMessage());
            return List.of(errorResult);
        }
    }

    /**
     * Execute single step
     */
    private StepResult executeStep(ParsedStep step, ValidationContext context) {
        LOG.debug("Executing step: {}", step.getText());

        try {
            // Find step definition
            StepDefinitionMatch match = stepRegistry.findMatch(step);

            if (match == null) {
                String error = "No step definition found for: " + step.getText();
                LOG.error(error);
                return new StepResult(step.getText(), false, error);
            }

            // Execute step definition
            match.execute(context);

            // Step passed
            return new StepResult(step.getText(), true, null);

        } catch (AssertionError e) {
            // Assertion failed
            LOG.debug("Step assertion failed: {}", step.getText());
            return new StepResult(step.getText(), false, e.getMessage());

        } catch (java.lang.reflect.InvocationTargetException e) {
            // Unwrap reflection exception
            Throwable cause = e.getCause();
            if (cause instanceof AssertionError) {
                LOG.debug("Step assertion failed: {}", step.getText());
                return new StepResult(step.getText(), false, cause.getMessage());
            } else {
                LOG.error("Step execution error: {}", step.getText(), cause);
                return new StepResult(step.getText(), false, cause != null ? cause.getMessage() : e.getMessage());
            }

        } catch (Exception e) {
            // Execution error
            LOG.error("Step execution error: {}", step.getText(), e);
            return new StepResult(step.getText(), false, e.getMessage());
        }
    }

    /**
     * Build ScenarioDetails from variables stored in ValidationContext.
     * This allows us to persist source/target counts and related metrics
     * to ScenarioResult.details for both passing and failing scenarios.
     */
    private ScenarioDetails buildScenarioDetailsFromContext(ValidationContext context) {
        ScenarioDetails details = new ScenarioDetails();

        // Values from ComparisonSteps.compareListFromSourceToTarget

        Integer comparisonSourceCount = context.getVariable("comparison_source_count", Integer.class);
        Integer comparisonTargetCount = context.getVariable("comparison_target_count", Integer.class);

        details.setComparisonSourceCount(comparisonSourceCount);
        details.setComparisonTargetCount(comparisonTargetCount);

        // If nothing was populated, return null to avoid cluttering results
        boolean hasComparisonCounts = comparisonSourceCount != null || comparisonTargetCount != null;
        //boolean hasCountComparison = countSourceCount != null || countTargetCount != null;

        if (!hasComparisonCounts /*&& !hasCountComparison*/) {
            return null;
        }

        return details;
    }

    /**
     * Check if all scenarios passed
     */
    private boolean allScenariosPassed(List<ScenarioResult> results) {
        return results.stream().allMatch(ScenarioResult::isPassed);
    }

    /**
     * Shutdown executor (cleanup)
     */
    public void shutdown() {
        LOG.info("Shutting down GherkinExecutor");
        executorService.shutdown();
        try {
            if (!executorService.awaitTermination(60, TimeUnit.SECONDS)) {
                executorService.shutdownNow();
            }
        } catch (InterruptedException e) {
            executorService.shutdownNow();
            Thread.currentThread().interrupt();
        }
    }

    /**
     * Get step registry (for registering custom steps)
     */
    public StepDefinitionRegistry getStepRegistry() {
        return stepRegistry;
    }
}
