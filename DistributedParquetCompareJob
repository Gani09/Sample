package com.fiserv.fef.parquet.distributed;

import org.apache.avro.Schema;
import org.apache.flink.api.common.state.ValueState;
import org.apache.flink.api.common.state.ValueStateDescriptor;
import org.apache.flink.api.common.typeinfo.TypeInformation;
import org.apache.flink.configuration.Configuration;
import org.apache.flink.streaming.api.datastream.DataStream;
import org.apache.flink.streaming.api.environment.StreamExecutionEnvironment;
import org.apache.flink.streaming.api.functions.co.KeyedCoProcessFunction;
import org.apache.flink.util.Collector;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;

import java.io.Serializable;
import java.util.*;

/**
 * Distributed Parquet Comparison using Flink FileSource.
 *
 * Designed for large-scale comparisons (10M+ records, 2500+ fields) distributed
 * across multiple task slots using Flink's native parallel file reading and keyed joins.
 *
 * Architecture:
 *   FileSource(source.parquet) --keyBy(joinKey)--> CoProcess <-- keyBy(joinKey)-- FileSource(target.parquet)
 *                                                     |
 *                                                     v
 *                                              Mismatch Results
 *
 * Each task slot handles a partition of keys, comparing all fields for matched records.
 */
public class DistributedParquetCompareJob {

    private static final Logger LOG = LoggerFactory.getLogger(DistributedParquetCompareJob.class);

    /**
     * Configuration for the distributed comparison job.
     */
    public static class CompareConfig implements Serializable {
        private static final long serialVersionUID = 1L;

        private final String sourcePath;
        private final String targetPath;
        private final String joinKey;
        private final List<String> fieldsToCompare; // empty = all fields
        private final Map<String, Boolean> expectedUpdates; // field -> expected updated?
        private final boolean validateRemainingUnchanged;
        private final int parallelism;

        public CompareConfig(String sourcePath, String targetPath, String joinKey,
                             List<String> fieldsToCompare, Map<String, Boolean> expectedUpdates,
                             boolean validateRemainingUnchanged, int parallelism) {
            this.sourcePath = sourcePath;
            this.targetPath = targetPath;
            this.joinKey = joinKey;
            this.fieldsToCompare = fieldsToCompare != null ? fieldsToCompare : List.of();
            this.expectedUpdates = expectedUpdates != null ? expectedUpdates : Map.of();
            this.validateRemainingUnchanged = validateRemainingUnchanged;
            this.parallelism = parallelism;
        }

        public String getSourcePath() { return sourcePath; }
        public String getTargetPath() { return targetPath; }
        public String getJoinKey() { return joinKey; }
        public List<String> getFieldsToCompare() { return fieldsToCompare; }
        public Map<String, Boolean> getExpectedUpdates() { return expectedUpdates; }
        public boolean isValidateRemainingUnchanged() { return validateRemainingUnchanged; }
        public int getParallelism() { return parallelism; }
    }

    /**
     * Result of a field comparison for one record.
     */
    public static class CompareResult implements Serializable {
        private static final long serialVersionUID = 1L;

        private final String key;
        private final String field;
        private final String sourceValue;
        private final String targetValue;
        private final String status; // "MISMATCH", "MISSING_SOURCE", "MISSING_TARGET", "MATCH"

        public CompareResult(String key, String field, String sourceValue, String targetValue, String status) {
            this.key = key;
            this.field = field;
            this.sourceValue = sourceValue;
            this.targetValue = targetValue;
            this.status = status;
        }

        public String getKey() { return key; }
        public String getField() { return field; }
        public String getSourceValue() { return sourceValue; }
        public String getTargetValue() { return targetValue; }
        public String getStatus() { return status; }

        @Override
        public String toString() {
            return String.format("key=%s field=%s status=%s src='%s' tgt='%s'",
                    key, field, status, sourceValue, targetValue);
        }
    }

    /**
     * Aggregated comparison summary.
     */
    public static class CompareSummary implements Serializable {
        private static final long serialVersionUID = 1L;

        public long totalSourceRecords;
        public long totalTargetRecords;
        public long matchedKeys;
        public long missingInSource;
        public long missingInTarget;
        public long fieldMismatches;
        public long fieldMatches;
        public List<CompareResult> sampleFailures = new ArrayList<>(); // First N failures
        public boolean passed;

        public String toSummaryString() {
            return String.format(
                    "Comparison Summary: passed=%s, source=%d, target=%d, matched=%d, " +
                            "missingSource=%d, missingTarget=%d, fieldMismatches=%d, fieldMatches=%d",
                    passed, totalSourceRecords, totalTargetRecords, matchedKeys,
                    missingInSource, missingInTarget, fieldMismatches, fieldMatches);
        }
    }

    /**
     * Execute the distributed comparison job with separate schemas for source and target.
     * This avoids UnresolvedUnionException when schemas differ between files.
     *
     * @param env          Flink StreamExecutionEnvironment
     * @param config       Comparison configuration
     * @param sourceSchema Avro schema for the source parquet file
     * @param targetSchema Avro schema for the target parquet file
     * @return DataStream of CompareResults (mismatches only)
     */
    public static DataStream<CompareResult> execute(
            StreamExecutionEnvironment env,
            CompareConfig config,
            Schema sourceSchema,
            Schema targetSchema) {
        return execute(env, config, sourceSchema, targetSchema, false);
    }

    /**
     * Execute with option to use FileSource for parallel reading.
     *
     * @param env          Flink StreamExecutionEnvironment
     * @param config       Comparison configuration
     * @param sourceSchema Avro schema for the source parquet file (can be null if useFileSource=true)
     * @param targetSchema Avro schema for the target parquet file (can be null if useFileSource=true)
     * @param useFileSource If true, use Flink's FileSource API for 10-20x faster parallel reads
     * @return DataStream of CompareResults (mismatches only)
     */
    public static DataStream<CompareResult> execute(
            StreamExecutionEnvironment env,
            CompareConfig config,
            Schema sourceSchema,
            Schema targetSchema,
            boolean useFileSource) {

        LOG.info("[DistributedCompare] source={} target={} joinKey={} parallelism={} reader={}",
                config.getSourcePath(), config.getTargetPath(),
                config.getJoinKey(), config.getParallelism(),
                useFileSource ? "FileSource (parallel)" : "FastParquetSource (single-thread)");

        env.setParallelism(config.getParallelism());

        DataStream<TaggedRecord> sourceStream;
        DataStream<TaggedRecord> targetStream;

        if (useFileSource) {
            // ⚡ FAST: Use Flink's FileSource with parallel splits (10-20x faster)
            LOG.info("🚀 Using FileSource with {} parallel readers per file", config.getParallelism());

            sourceStream = ParallelParquetFileSource.readParquet(
                    env, config.getSourcePath(), config.getJoinKey(), "SOURCE", config.getParallelism());

            targetStream = ParallelParquetFileSource.readParquet(
                    env, config.getTargetPath(), config.getJoinKey(), "TARGET", config.getParallelism());

        } else {
            // 🐌 SLOW: Use custom single-threaded reader (legacy)
            LOG.warn("⚠️  Using single-threaded FastParquetSource - consider enabling FileSource for 10-20x speedup");

            sourceStream = env
                    .addSource(new FastParquetSource(
                            config.getSourcePath(), config.getJoinKey(), "SOURCE"))
                    .setParallelism(1)
                    .name("Source-Parquet-Fast")
                    .returns(TypeInformation.of(TaggedRecord.class));

            targetStream = env
                    .addSource(new FastParquetSource(
                            config.getTargetPath(), config.getJoinKey(), "TARGET"))
                    .setParallelism(1)
                    .name("Target-Parquet-Fast")
                    .returns(TypeInformation.of(TaggedRecord.class));
        }

        // Key by join key, connect, and compare
        DataStream<CompareResult> results = sourceStream
                .keyBy(TaggedRecord::getKey)
                .connect(targetStream.keyBy(TaggedRecord::getKey))
                .process(new FieldCompareFunction(config))
                .name("Field-Compare");

        return results;
    }

    /**
     * Execute with a single schema (legacy). Uses the same schema for both files.
     * @deprecated Use {@link #execute(StreamExecutionEnvironment, CompareConfig)} instead.
     */
    @Deprecated
    public static DataStream<CompareResult> execute(
            StreamExecutionEnvironment env,
            CompareConfig config,
            Schema schema) {
        return execute(env, config);
    }

    /**
     * Execute without schemas. ParquetTaggedRecordSource reads the file's own schema.
     */
    public static DataStream<CompareResult> execute(
            StreamExecutionEnvironment env,
            CompareConfig config) {
        return execute(env, config, null, null);
    }

    /**
     * Tagged record: holds the join key, hash bytes, and which side (SOURCE/TARGET).
     *
     * All fields have public getters AND setters + no-arg constructor → valid Flink POJO.
     * Flink uses its fast POJO serializer instead of slow Kryo for network transfer and state.
     */
    public static class TaggedRecord implements Serializable {
        private static final long serialVersionUID = 1L;

        public String key;
        public byte[] recordBytes; // hash bytes (4 bytes)
        public String side;        // "SOURCE" or "TARGET"

        public TaggedRecord() {}

        public TaggedRecord(String key, byte[] recordBytes, String side) {
            this.key = key;
            this.recordBytes = recordBytes;
            this.side = side;
        }

        // Getters + Setters — required for Flink POJO detection
        public String getKey()               { return key; }
        public void   setKey(String key)     { this.key = key; }

        public byte[] getRecordBytes()                   { return recordBytes; }
        public void   setRecordBytes(byte[] recordBytes) { this.recordBytes = recordBytes; }

        public String getSide()              { return side; }
        public void   setSide(String side)   { this.side = side; }
    }


    /**
     * Keyed CoProcessFunction that joins source and target by key,
     * then compares all fields and emits mismatches.
     *
     * Uses Flink managed state to buffer records until both sides arrive.
     */
    private static class FieldCompareFunction
            extends KeyedCoProcessFunction<String, TaggedRecord, TaggedRecord, CompareResult> {

        private static final long serialVersionUID = 1L;
        private static final Logger LOG = LoggerFactory.getLogger(FieldCompareFunction.class);

        private final CompareConfig config;

        // State: buffer source/target until the other side arrives
        private transient ValueState<TaggedRecord> sourceState;
        private transient ValueState<TaggedRecord> targetState;

        FieldCompareFunction(CompareConfig config) {
            this.config = config;
        }

        @Override
        public void open(Configuration parameters) {
            // Use TypeHint to ensure Flink detects TaggedRecord as POJO (not Kryo GenericType)
            org.apache.flink.api.common.typeinfo.TypeInformation<TaggedRecord> taggedRecordType =
                    org.apache.flink.api.java.typeutils.TypeExtractor.getForClass(TaggedRecord.class);
            sourceState = getRuntimeContext().getState(
                    new ValueStateDescriptor<>("source", taggedRecordType));
            targetState = getRuntimeContext().getState(
                    new ValueStateDescriptor<>("target", taggedRecordType));
        }

        @Override
        public void processElement1(TaggedRecord source, Context ctx, Collector<CompareResult> out) throws Exception {
            // Pass sentinel records directly as metadata
            if (FastParquetSource.SENTINEL_KEY.equals(source.getKey())) {
                // Sentinel detected - emit metadata (we'll track counts externally)
                out.collect(new CompareResult(source.getKey(), "__META__",
                        "SENTINEL", "SENTINEL", "SENTINEL_SOURCE"));
                return;
            }

            TaggedRecord target = targetState.value();
            if (target != null) {
                // Both sides present — compare
                compareAndEmit(source, target, out);
                targetState.clear();
            } else {
                // Buffer source, wait for target (no timer for batch processing)
                sourceState.update(source);
            }
        }

        @Override
        public void processElement2(TaggedRecord target, Context ctx, Collector<CompareResult> out) throws Exception {
            // Pass sentinel records directly as metadata
            if (FastParquetSource.SENTINEL_KEY.equals(target.getKey())) {
                // Sentinel detected - emit metadata
                out.collect(new CompareResult(target.getKey(), "__META__",
                        "SENTINEL", "SENTINEL", "SENTINEL_TARGET"));
                return;
            }

            TaggedRecord source = sourceState.value();
            if (source != null) {
                // Both sides present — compare
                compareAndEmit(source, target, out);
                sourceState.clear();
            } else {
                // Buffer target, wait for source (no timer for batch processing)
                targetState.update(target);
            }
        }

        /**
         * Compare hash bytes between source and target.
         * ULTRA-OPTIMIZED: 4-byte hash comparison is extremely fast.
         */
        private void compareAndEmit(TaggedRecord source, TaggedRecord target, Collector<CompareResult> out) {
            String key = source.getKey();
            byte[] srcBytes = source.getRecordBytes();
            byte[] tgtBytes = target.getRecordBytes();

            // Fast path: byte-level equality check (just 4 bytes!)
            if (Arrays.equals(srcBytes, tgtBytes)) {
                // Records are identical - no mismatch
                return;
            }

            // Hash mismatch detected - records differ
            int srcHash = bytesToInt(srcBytes);
            int tgtHash = bytesToInt(tgtBytes);
            out.collect(new CompareResult(key, "*RECORD_HASH*",
                    "HASH:" + srcHash,
                    "HASH:" + tgtHash,
                    "MISMATCH"));
        }

        private int bytesToInt(byte[] bytes) {
            return ((bytes[0] & 0xFF) << 24) |
                   ((bytes[1] & 0xFF) << 16) |
                   ((bytes[2] & 0xFF) << 8) |
                   (bytes[3] & 0xFF);
        }
    }
}






