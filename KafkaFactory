package com.fiserv.fef.kafka;

import org.apache.flink.api.common.serialization.SimpleStringSchema;
import org.apache.flink.connector.kafka.source.KafkaSource;
import org.apache.flink.connector.kafka.source.KafkaSourceBuilder;
import org.apache.flink.connector.kafka.source.enumerator.initializer.OffsetsInitializer;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;

/**
 * Factory for creating Flink Kafka sources based on KafkaConfig.
 */
public class KafkaFactory {
    private static final Logger LOG = LoggerFactory.getLogger(KafkaFactory.class);
    /**
     * Creates a KafkaSource for a specific TopicGroup in KafkaConfig.
     */
    public static KafkaSource<String> createKafkaSource(KafkaConfig kafkaConfig, KafkaConfig.TopicGroup tg) {
        try {
            KafkaSourceBuilder<String> builder = KafkaSource.<String>builder()
                    .setBootstrapServers(kafkaConfig.getBootstrapServer())
                    .setTopics(tg.topic)
                    .setGroupId(tg.groupId)
                    .setStartingOffsets(OffsetsInitializer.earliest())
                    .setValueOnlyDeserializer(new SimpleStringSchema());
            // Set SSL properties if present
            if (kafkaConfig.getSslKeyStore() != null && !kafkaConfig.getSslKeyStore().isEmpty()) {
                builder.setProperty("security.protocol", "SSL");
                builder.setProperty("ssl.keystore.location", kafkaConfig.getSslKeyStore());
                builder.setProperty("ssl.truststore.location", kafkaConfig.getSslTrustStore());
                builder.setProperty("ssl.keystore.password", kafkaConfig.getSslPwd());
                builder.setProperty("ssl.truststore.password", kafkaConfig.getSslPwd());
            }
            return builder.build();
        } catch (Exception e) {
            LOG.error("Failed to create KafkaSource for topic group: {}", tg.topic, e);
            return null;
        }
    }

    private KafkaFactory() {
        // Prevent instantiation
    }
}
