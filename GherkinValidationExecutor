package com.fiserv.fef.gherkin;

import com.fiserv.fef.exceptions.GherkinExecutionException;
import com.fiserv.fef.models.ValidationConfig;
import com.fiserv.fef.models.ValidationResult;
import com.fiserv.fef.utils.MongoDBClientFactory;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;

/**
 * Implementation of ValidationExecutor that uses Gherkin features
 * This is the main entry point for executing Gherkin-based validations
 */
public class GherkinValidationExecutor implements ValidationExecutor {

    private static final Logger LOG = LoggerFactory.getLogger(GherkinValidationExecutor.class);

    private final GherkinExecutor gherkinExecutor;
    private final FeatureLoader featureLoader;

    // Singleton for performance (reuse thread pool)
    private static GherkinValidationExecutor instance;

    public GherkinValidationExecutor() {
        this.gherkinExecutor = new GherkinExecutor(4);  // 4 parallel scenarios
        this.featureLoader = new FeatureLoader();

        // Register step definitions
        initializeStepDefinitions();

        LOG.info("GherkinValidationExecutor initialized");
    }

    /**
     * Get or create singleton instance
     */
    public static synchronized GherkinValidationExecutor getInstance() {
        if (instance == null) {
            instance = new GherkinValidationExecutor();
        }
        return instance;
    }

    /**
     * Initialize step definitions
     * Scans com.fiserv.fef.stepdefs package for step definition classes
     */
    private void initializeStepDefinitions() {
        LOG.info("Initializing step definitions");

        try {
            // Scan for step definition classes
            java.util.List<Class<?>> stepDefClasses =
                    StepDefinitionScanner.scanPackage("com.fiserv.fef.stepdefs");

            // Register each class
            StepDefinitionRegistry registry = gherkinExecutor.getStepRegistry();
            for (Class<?> stepDefClass : stepDefClasses) {
                registry.registerStepDefinitionClass(stepDefClass);
            }

            LOG.info("Registered {} step definition classes, {} total steps",
                    stepDefClasses.size(), registry.getStepDefinitionCount());

        } catch (Exception e) {
            LOG.error("Failed to initialize step definitions", e);
        }
    }

    @Override
    public ValidationResult execute(ValidationConfig config, ValidationContext context) {
        LOG.info("Executing Gherkin validation: {} , Source Tenant Database: {} and Target Tenant Database: {}\"", config.getValidationID(), context.getSrcTenantDatabase().getName() , context.getTargetTenantDatabase().getName());
        // Activate tenant DB routing for PHASE 5 & 6 BEFORE any DB operation
        ValidationContext.setCurrent(context);

        try {
            // Load Gherkin feature
            String featureID = config.getFeatureID();
            if (featureID == null || featureID.isEmpty()) {
                throw new GherkinExecutionException(
                        "No Gherkin feature ID specified",
                        config.getValidationID(),
                        null
                );
            }

            String featureText = featureLoader.loadFeature(featureID);

            // Set MongoDB client in context
            context.setMongoClient(MongoDBClientFactory.getClient());

            // Execute feature
            ValidationResult result = gherkinExecutor.execute(featureText, context);
            result.setValidationID(config.getValidationID());

            return result;


        } catch (GherkinExecutionException e) {
            LOG.error("Gherkin execution failed: {}", config.getValidationID(), e);

            ValidationResult result = new ValidationResult(config.getValidationID());
            result.setPassed(false);
            result.setErrorMessage(e.getMessage());

            return result;

        } catch (Exception e) {
            LOG.error("Validation execution failed: {}", config.getValidationID(), e);
            ValidationResult result = new ValidationResult(config.getValidationID());
            result.setPassed(false);
            result.setErrorMessage("Execution failed: " + e.getMessage());

            return result;
        } finally {
            // Always clean up thread-local to prevent leaks
            ValidationContext.removeCurrent();

        }
    }

    @Override
    public boolean canHandle(ValidationConfig config) {
        // Always return true since only Gherkin validation is supported
        return true;
    }

    @Override
    public String getExecutorType() {
        return "gherkin";
    }

    /**
     * Shutdown executor (cleanup)
     */
    public void shutdown() {
        LOG.info("Shutting down GherkinValidationExecutor");
        gherkinExecutor.shutdown();
    }

    /**
     * Get step registry (for testing/debugging)
     */
    public StepDefinitionRegistry getStepRegistry() {
        return gherkinExecutor.getStepRegistry();
    }
}
