package com.fiserv.fef.parquet.util;

import org.apache.hadoop.conf.Configuration;
import org.apache.hadoop.fs.FileSystem;
import org.apache.hadoop.fs.Path;
import org.apache.hadoop.security.UserGroupInformation;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;

import java.io.File;
import java.net.URL;
import java.security.PrivilegedExceptionAction;

/** Path utilities used by readers/services. */
public final class ParquetReaderUtil {
    private static final Logger LOGGER = LoggerFactory.getLogger(ParquetReaderUtil.class);

    private ParquetReaderUtil() { /* utility */ }

    public static String resolveParquetFilePath(String parquetFilePath, String hdfsDefaultFs) {
        String fullFileName = parquetFilePath != null && parquetFilePath.endsWith(".parquet")
                ? parquetFilePath
                : parquetFilePath + ".parquet";

        if (fullFileName.startsWith("hdfs://") || fullFileName.startsWith("jar:")) {
            return fullFileName;
        }

        // If fs.defaultFS is HDFS and path is absolute, always construct HDFS path
        if (hdfsDefaultFs != null && hdfsDefaultFs.startsWith("hdfs://") && fullFileName.startsWith("/")) {
            String fs = hdfsDefaultFs.endsWith("/")
                    ? hdfsDefaultFs.substring(0, hdfsDefaultFs.length() - 1)
                    : hdfsDefaultFs;
            return fs + fullFileName;
        }

        // Fix for file:/C:/... -> file:///C:/...
        if (fullFileName.startsWith("file:/") && !fullFileName.startsWith("file:///")) {
            if (fullFileName.length() > 6 && fullFileName.charAt(6) == ':') {
                return "file:///" + fullFileName.substring(6);
            }
            return fullFileName.replace("file:/", "file:///");
        }

        // Local file
        File localFile = new File(fullFileName);
        if (localFile.exists()) {
            String uri = localFile.toURI().toString();
            if (uri.startsWith("file:/") && !uri.startsWith("file:///")) {
                if (uri.length() > 6 && uri.charAt(6) == ':') {
                    return "file:///" + uri.substring(6);
                }
                return uri.replace("file:/", "file:///");
            }
            return uri;
        }

        // /work directory (OpenShift)
        File workFile = new File("/work/", fullFileName);
        if (workFile.exists()) {
            String uri = workFile.toURI().toString();
            if (uri.startsWith("file:/") && !uri.startsWith("file:///")) {
                if (uri.length() > 6 && uri.charAt(6) == ':') {
                    return "file:///" + uri.substring(6);
                }
                return uri.replace("file:/", "file:///");
            }
            return uri;
        }

        // Classpath resource
        URL resource = ParquetReaderUtil.class.getClassLoader().getResource(fullFileName);
        if (resource != null) {
            return resource.toString();
        }

        // Fallback: treat as local file URI
        String uri = new File(fullFileName).toURI().toString();
        if (uri.startsWith("file:/") && !uri.startsWith("file:///")) {
            if (uri.length() > 6 && uri.charAt(6) == ':') {
                return "file:///" + uri.substring(6);
            }
            return uri.replace("file:/", "file:///");
        }
        return uri;
    }

    public static boolean fileExists(String path, Configuration conf) {
        final Path p = new Path(path);
        try {
            if ("file".equalsIgnoreCase(p.toUri().getScheme())) {
                return p.getFileSystem(conf).exists(p);
            }
            UserGroupInformation login = UserGroupInformation.getLoginUser();
            if (login == null) {
                throw new IllegalStateException("Kerberos login user is null. Ensure HadoopConfig.create() ran successfully.");
            }
            final boolean disableCache = conf.getBoolean("fs.hdfs.impl.disable.cache", false);
            return login.doAs((PrivilegedExceptionAction<Boolean>) () -> {
                FileSystem fs = p.getFileSystem(conf);
                try {
                    return fs.exists(p);
                } finally {
                    if (disableCache) {
                        try { fs.close(); } catch (Exception ignore) {}
                    }
                }
            });
        } catch (Exception e) {
            throw new RuntimeException("Error checking file existence: " + path, e);
        }
    }
}
