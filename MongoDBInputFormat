package com.fiserv.fef.datasources;

import com.fiserv.fef.utils.MongoDBClientFactory;
import com.mongodb.client.MongoCollection;
import com.mongodb.client.MongoCursor;
import org.apache.flink.api.common.io.DefaultInputSplitAssigner;
import org.apache.flink.api.common.io.InputFormat;
import org.apache.flink.api.common.io.statistics.BaseStatistics;
import org.apache.flink.configuration.Configuration;
import org.apache.flink.core.io.InputSplitAssigner;
import org.bson.Document;
import org.bson.types.ObjectId;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;

import java.io.IOException;
import java.util.ArrayList;
import java.util.Date;
import java.util.List;

/**
 * Flink InputFormat for MongoDB
 * Splits data by _id ranges for parallel reading
 */
public class MongoDBInputFormat implements InputFormat<Document, MongoDBInputSplit> {

    private static final Logger LOG = LoggerFactory.getLogger(MongoDBInputFormat.class);

    private final String collection;
    private final Document filter;
    private final int numSplits;

    private transient MongoCollection<Document> mongoCollection;
    private transient MongoCursor<Document> cursor;
    private transient MongoDBInputSplit currentSplit;

    public MongoDBInputFormat(String collection, Document filter, int numSplits) {
        this.collection = collection;
        this.filter = filter != null ? filter : new Document();
        this.numSplits = numSplits;
    }

    @Override
    public void configure(Configuration parameters) {
        // Configuration if needed
    }

    @Override
    public BaseStatistics getStatistics(BaseStatistics cachedStatistics) {
        return cachedStatistics;
    }

    @Override
    public MongoDBInputSplit[] createInputSplits(int minNumSplits) throws IOException {
        LOG.info("Creating {} input splits for collection: {}", numSplits, collection);

        try {
            MongoCollection<Document> coll = MongoDBClientFactory.getDatabase()
                    .getCollection(collection);

            // Find min and max _id
            Document minDoc = coll.find(filter)
                    .sort(new Document("_id", 1))
                    .limit(1)
                    .first();

            Document maxDoc = coll.find(filter)
                    .sort(new Document("_id", -1))
                    .limit(1)
                    .first();

            if (minDoc == null || maxDoc == null) {
                LOG.warn("No documents found for splitting");
                return new MongoDBInputSplit[]{new MongoDBInputSplit(0, null, null)};
            }

            ObjectId minId = minDoc.getObjectId("_id");
            ObjectId maxId = maxDoc.getObjectId("_id");

            // Create splits by _id ranges
            List<MongoDBInputSplit> splits = createSplitsByTimestamp(minId, maxId, numSplits);

            LOG.info("Created {} splits", splits.size());
            return splits.toArray(new MongoDBInputSplit[0]);

        } catch (Exception e) {
            LOG.error("Failed to create input splits", e);
            throw new IOException("Failed to create input splits", e);
        }
    }

    /**
     * Create splits based on ObjectId timestamp
     * ObjectId format: 4-byte timestamp + 5-byte random + 3-byte counter
     */
    private List<MongoDBInputSplit> createSplitsByTimestamp(ObjectId minId, ObjectId maxId, int numSplits) {
        List<MongoDBInputSplit> splits = new ArrayList<>();

        // Get timestamp portion (first 4 bytes)
        Date minDate = minId.getDate();
        Date maxDate = maxId.getDate();

        long minTime = minDate.getTime();
        long maxTime = maxDate.getTime();
        long totalRange = maxTime - minTime;

        // If range is very small, just create one split per document
        if (totalRange < numSplits) {
            LOG.warn("Time range too small for {} splits, creating single split", numSplits);
            splits.add(new MongoDBInputSplit(0, minId, maxId));
            return splits;
        }

        long rangePerSplit = totalRange / numSplits;

        for (int i = 0; i < numSplits; i++) {
            ObjectId startId;
            ObjectId endId;

            if (i == 0) {
                // First split starts at minimum
                startId = minId;
            } else {
                // Create ObjectId with timestamp boundary
                long splitTime = minTime + (i * rangePerSplit);
                startId = new ObjectId(new Date(splitTime));
            }

            if (i == numSplits - 1) {
                // Last split ends at maximum
                endId = maxId;
            } else {
                // Create ObjectId with timestamp boundary
                long splitTime = minTime + ((i + 1) * rangePerSplit);
                endId = new ObjectId(new Date(splitTime));
            }

            splits.add(new MongoDBInputSplit(i, startId, endId));

            LOG.debug("Split {}: {} to {}", i, startId, endId);
        }

        return splits;
    }

    @Override
    public InputSplitAssigner getInputSplitAssigner(MongoDBInputSplit[] inputSplits) {
        return new DefaultInputSplitAssigner(inputSplits);
    }

    @Override
    public void open(MongoDBInputSplit split) throws IOException {
        LOG.info("Opening split: {}", split.getSplitNumber());

        this.currentSplit = split;
        this.mongoCollection = MongoDBClientFactory.getDatabase().getCollection(collection);

        // Build query for this split
        Document splitFilter = new Document(filter);

        if (split.getStartId() != null && split.getEndId() != null) {
            splitFilter.append("_id", new Document("$gte", split.getStartId())
                    .append("$lt", split.getEndId()));
        }

        LOG.debug("Split filter: {}", splitFilter.toJson());

        this.cursor = mongoCollection.find(splitFilter)
                .batchSize(10000)
                .noCursorTimeout(true)
                .iterator();
    }

    @Override
    public boolean reachedEnd() {
        return cursor == null || !cursor.hasNext();
    }

    @Override
    public Document nextRecord(Document reuse) {
        if (cursor != null && cursor.hasNext()) {
            return cursor.next();
        }
        return null;
    }

    @Override
    public void close() {
        if (cursor != null) {
            cursor.close();
            cursor = null;
        }
    }
}
 
