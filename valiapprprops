# Validation Configuration

# =====================================================
# SCENARIO PARALLELISM (Level 4 - Java Threads)
# =====================================================
# validation.gherkin.scenario.parallelism: Number of scenarios to run in parallel per feature
# This uses Java ExecutorService with thread pool (NOT Flink parallelism)
# Each worker job creates its own thread pool for scenario execution
# Example: Feature file with 4 scenarios + parallelism=4 ? all 4 run concurrently
#          Feature file with 10 scenarios + parallelism=4 ? 4 at a time, then 4, then 2
validation.gherkin.scenario.parallelism=4

validation.execution.timeout=600000

