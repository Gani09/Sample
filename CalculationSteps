package com.fiserv.fef.stepdefs;

import com.fiserv.fef.gherkin.ValidationContext;
import com.fiserv.fef.models.Dataset;
import com.fiserv.fef.gherkin.annotations.When;
import org.bson.Document;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;

import java.util.HashMap;
import java.util.Map;

/**
 * Step definitions for calculations and aggregations
 */
public class CalculationSteps {

    private static final Logger LOG = LoggerFactory.getLogger(CalculationSteps.class);

    /**
     * Calculate sum of a field
     * Example: When I calculate sum of "amount" in source
     */
    @When("I calculate sum of {string} in source")
    public void calculateSumInSource(String fieldName) {
        LOG.info("Calculating sum of: {}", fieldName);

        ValidationContext context = ValidationContext.getCurrent();
        Dataset source = context.getDataset("source");

        if (source == null) {
            throw new IllegalStateException("Source dataset not loaded");
        }

        double sum = 0.0;
        int count = 0;

        for (Document doc : source) {
            Object value = doc.get(fieldName);
            if (value != null) {
                sum += convertToDouble(value);
                count++;
            }
        }

        context.setVariable("calculated_sum", sum);
        context.setVariable("calculated_field", fieldName);
        context.setVariable("sum_record_count", count);

        LOG.info("Sum of {}: {} (from {} records)", fieldName, sum, count);
    }

    /**
     * Calculate average of a field
     * Example: When I calculate average of "balance" in target
     */
    @When("I calculate average of {string} in target")
    public void calculateAverageInTarget(String fieldName) {
        LOG.info("Calculating average of: {}", fieldName);

        ValidationContext context = ValidationContext.getCurrent();
        Dataset target = context.getDataset("target");

        if (target == null) {
            throw new IllegalStateException("Target dataset not loaded");
        }

        double sum = 0.0;
        int count = 0;

        for (Document doc : target) {
            Object value = doc.get(fieldName);
            if (value != null) {
                sum += convertToDouble(value);
                count++;
            }
        }

        double average = count > 0 ? sum / count : 0.0;

        context.setVariable("calculated_average", average);
        context.setVariable("calculated_field", fieldName);
        context.setVariable("average_record_count", count);

        LOG.info("Average of {}: {} (from {} records)", fieldName, average, count);
    }

    /**
     * Group records by a field and count
     * Example: When I group source records by "accountType"
     */
    @When("I group source records by {string}")
    public void groupSourceRecordsBy(String fieldName) {
        LOG.info("Grouping source records by: {}", fieldName);

        ValidationContext context = ValidationContext.getCurrent();
        Dataset source = context.getDataset("source");

        if (source == null) {
            throw new IllegalStateException("Source dataset not loaded");
        }

        Map<Object, Integer> groupCounts = new HashMap<>();

        for (Document doc : source) {
            Object value = doc.get(fieldName);
            if (value != null) {
                groupCounts.put(value, groupCounts.getOrDefault(value, 0) + 1);
            }
        }

        context.setVariable("group_field", fieldName);
        context.setVariable("group_counts", groupCounts);
        context.setVariable("unique_groups", groupCounts.size());

        LOG.info("Grouped by {}: {} unique values", fieldName, groupCounts.size());
    }

    /**
     * Count records by business date
     * Example: When I count records by business_date
     */
    @When("I count records by business_date")
    public void countRecordsByBusinessDate() {
        LOG.info("Counting records by business_date");

        ValidationContext context = ValidationContext.getCurrent();
        Dataset source = context.getDataset("source");

        if (source == null) {
            throw new IllegalStateException("Source dataset not loaded");
        }

        Map<String, Integer> dateCounts = new HashMap<>();

        for (Document doc : source) {
            String date = doc.getString("business_date");
            if (date != null) {
                dateCounts.put(date, dateCounts.getOrDefault(date, 0) + 1);
            }
        }

        context.setVariable("date_counts", dateCounts);
        context.setVariable("unique_dates", dateCounts.size());

        LOG.info("Counted records across {} dates", dateCounts.size());
    }

    /**
     * Helper method to convert various numeric types to double
     */
    private double convertToDouble(Object value) {
        if (value instanceof Number) {
            return ((Number) value).doubleValue();
        } else if (value instanceof String) {
            try {
                return Double.parseDouble((String) value);
            } catch (NumberFormatException e) {
                return 0.0;
            }
        }
        return 0.0;
    }
}
