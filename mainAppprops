# =====================================================
# PARALLELISM CONFIGURATION - Three Levels
# =====================================================

# LEVEL 1: Flink Environment Parallelism
# flink.default.parallelism: Default parallelism for all Flink operators (unless overridden)
# This is the base parallelism level for the Flink execution environment
# Individual operators in the job can override this setting
flink.default.parallelism=4

# LEVEL 2: Pipeline-Level Parallelism (Flink Operator Parallelism)
# pipeline.max.triggers.per.poll: How many triggers to pick up from MongoDB in one poll cycle
# Example: 10 means up to 10 pipelines can be queued for processing at once
pipeline.max.triggers.per.poll=10

# pipeline.max.concurrent.pipelines: Number of TriggerProcessor instances (Flink parallelism)
# This is the MAIN JOB parallelism - how many SEPARATE pipelines run concurrently
# Each pipeline = one (processID + date) combination
# Example: 5 means 5 different pipelines can be processed at the same time
# NOTE: This is set via .setParallelism() in MainValidationJob.java
pipeline.max.concurrent.pipelines=5

# LEVEL 3: Worker Job Parallelism (Separate Flink Jobs)
# Each pipeline submits multiple worker jobs (one per validation)
# Worker jobs run as SEPARATE Flink jobs in the cluster
# Actual concurrency limited by: min(worker.job.max-parallel, available_task_slots)
# Example: If pipeline has 10 validations ? submits 10 worker jobs
#          If cluster has 50 task slots ? all 10 run concurrently
#          If cluster has only 5 task slots ? only 5 run at a time (rest queued)

