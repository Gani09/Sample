# =====================================================
# WORKER JOB CONFIGURATION
# =====================================================
# Worker jobs are SEPARATE Flink jobs submitted by TriggerProcessor
# Each validation in a pipeline gets its own worker job

worker.job.jar.path=/work/fef-worker-job.jar
worker.job.timeout=3600000

# worker.job.max-parallel: Maximum concurrent worker jobs to submit at once (per pipeline)
# This limits how many worker jobs one TriggerProcessor will submit simultaneously
# Actual concurrency also limited by Flink cluster's available task slots
# Example: Pipeline with 10 validations + max-parallel=50 ? submits all 10 at once
#          Pipeline with 100 validations + max-parallel=50 ? submits 50, waits, then 50 more
worker.job.max-parallel=50
# https://gitlab.onefiserv.net/issuers/transformed-optis-platform/otp-qa-automation/fiserv-fef/fef-flink-engine-jobs.git
# worker.job.thread.pool.size: Thread pool size for monitoring worker job status
# This is used by JobSubmitter to check job completion status concurrently
# Does NOT affect actual validation execution parallelism
worker.job.thread.pool.size=20

# =====================================================
